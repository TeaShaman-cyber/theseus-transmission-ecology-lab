#!/bin/sh
set -eu
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' 'research-check: not inside a Git worktree' >&2
    exit 2
}
cd "$ROOT"
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec python3 -m transmission_ecology.research_qa --root "$ROOT" "$@"
